# Kizuna-Zek AI Studio Environment Configuration Example

# Alibaba Cloud Model Studio / DashScope API (Primary Engine)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://ws-sitvcc6ml5lia10m.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Google Gemini API (Secondary Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM Microservices (Fallback Engine)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Server Port
PORT=3000
NODE_ENV=development
